

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=1000000
JWT_REFRESH_EXPIRATION_DAYS=100
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10


DOMAIN=http://localhost:8080
PORT=8080

#localhost
DB_HOST=localhost
DB_USER=postgres
DB_PORT=5432
DB_PASSWORD=123456
DB_DATABASE=nodejs-boilerplate

# ── File upload / object storage ─────────────────────────────────────────────
# STORAGE_DRIVER selects where uploaded bytes go: "cloudinary" or "local".
# "local" needs no credentials and writes to LOCAL_UPLOAD_DIR (dev fallback).
STORAGE_DRIVER=local

# Accepted per-file size (MB) and max files per multipart request.
UPLOAD_MAX_FILE_MB=5
UPLOAD_MAX_FILES=10

# Top-level namespace/prefix for every stored object.
UPLOAD_ROOT_FOLDER=wms

# Cloudinary (used only when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# "upload" = standard delivery, "authenticated" = signed/private delivery.
CLOUDINARY_DELIVERY_TYPE=upload

# Local driver (used only when STORAGE_DRIVER=local)
LOCAL_UPLOAD_DIR=uploads
LOCAL_PUBLIC_BASE_URL=http://localhost:8080/uploads

# ── Resume screening (Rezmatch.ai) ───────────────────────────────────────────
# Each new application's CV is scored ONCE against the job description via the
# Rezmatch.ai /match API, in a background worker; the score is cached on the
# application so ranking is instant and free. Safe-by-default: with no API key the
# screening simply doesn't run and the rest of the ATS is unaffected.
#
# Master on/off switch (independent of the key).
RESUME_SCREENING_ENABLED=true
# Get a key from the Rezmatch dashboard (looks like rz_live_...). Leave empty to disable.
REZMATCH_API_KEY=
REZMATCH_BASE_URL=https://api.rezmatch.ai
# /match parses the PDF + scores, which can take ~25-40s. Keep this generous.
REZMATCH_TIMEOUT_MS=90000
# Skip CVs larger than this many bytes (default 10MB; 0 disables).
REZMATCH_MAX_RESUME_BYTES=10485760

# Background worker tunables (mirror the email worker knobs).
RESUME_WORKER_ENABLED=true
RESUME_POLL_INTERVAL_MS=5000
RESUME_BATCH_SIZE=20
RESUME_CONCURRENCY=3
RESUME_STALE_LOCK_MS=300000
RESUME_MAX_ATTEMPTS=3
