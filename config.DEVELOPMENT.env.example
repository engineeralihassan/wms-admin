

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=1000000
JWT_REFRESH_EXPIRATION_DAYS=100
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10


DOMAIN=https://wmx-application-project-li1jzskhb-ali-hassan12.vercel.app/
PORT=8080

# Database connection
# Set DB_URL for a managed PostgreSQL database such as Neon. When set, it takes
# precedence over the split local variables below. DATABASE_URL is also supported.
# DB_URL=postgresql://user:password@host/database?sslmode=require
# DB_SSL=true

# Local PostgreSQL fallback (used when DB_URL and DATABASE_URL are empty)
DB_HOST=localhost
DB_USER=postgres
DB_PORT=5432
DB_PASSWORD=123456
DB_DATABASE=nodejs-boilerplate

# ── File upload / object storage ─────────────────────────────────────────────
# STORAGE_DRIVER selects where uploaded bytes go: "cloudinary" or "local".
# "local" needs no credentials and writes to LOCAL_UPLOAD_DIR (dev fallback).
STORAGE_DRIVER=local

# Accepted per-file size (MB) and max files per multipart request.
UPLOAD_MAX_FILE_MB=5
UPLOAD_MAX_FILES=10

# Top-level namespace/prefix for every stored object.
UPLOAD_ROOT_FOLDER=wms

# Cloudinary (used only when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# "upload" = standard delivery, "authenticated" = signed/private delivery.
CLOUDINARY_DELIVERY_TYPE=upload

# Local driver (used only when STORAGE_DRIVER=local)
LOCAL_UPLOAD_DIR=uploads
LOCAL_PUBLIC_BASE_URL=http://localhost:8080/uploads

# ── Resume screening (Rezmatch.ai) ───────────────────────────────────────────
# Each new application's CV is scored ONCE against the job description via the
# Rezmatch.ai /match API, in a background worker; the score is cached on the
# application so ranking is instant and free. Safe-by-default: with no API key the
# screening simply doesn't run and the rest of the ATS is unaffected.
#
# Master on/off switch (independent of the key).
RESUME_SCREENING_ENABLED=true
# Auto-screen every application on submit? Set false to only screen on demand (a
# recruiter clicks "Screen candidates"), which controls credit spend.
RESUME_AUTO_SCREEN=true
# Get a key from the Rezmatch dashboard (looks like rz_live_...). Leave empty to disable.
REZMATCH_API_KEY=
REZMATCH_BASE_URL=https://api.rezmatch.ai
# /match parses the PDF + scores, which can take ~25-40s. Keep this generous.
REZMATCH_TIMEOUT_MS=90000
# Skip CVs larger than this many bytes (default 10MB; 0 disables).
REZMATCH_MAX_RESUME_BYTES=10485760

# Background worker tunables (mirror the email worker knobs).
RESUME_WORKER_ENABLED=true
RESUME_POLL_INTERVAL_MS=5000
RESUME_BATCH_SIZE=20
RESUME_CONCURRENCY=3
RESUME_STALE_LOCK_MS=300000
RESUME_MAX_ATTEMPTS=3

# ── Timesheets (weekly auto-generation, reminders, lock) ─────────────────────
# A background worker runs three periodic passes off a durable DB queue:
#   generate — create each valid project member's weekly timesheet (Sun–Sat)
#   remind   — email owners who haven't submitted (Friday + Saturday)
#   lock     — lock overdue-unsubmitted sheets, notify approvers, open a backfill ticket
# Generation is once-per-week-per-member and idempotent; the SCHEDULE interval only
# controls how often we re-check so a newly-added member or a missed week is caught.
# Default: check once a day. Each daily run covers the current AND previous week, so a
# member is never left without a timesheet even after downtime across a week boundary.
TIMESHEET_WORKER_ENABLED=true
# How often the scheduler re-checks (ms). Default 24h. Lower it to catch new members
# faster; the check is a couple of indexed reads, so cost is negligible either way.
TIMESHEET_SCHEDULE_INTERVAL_MS=86400000
# How often the worker drains queued jobs (ms). Default 1 min.
TIMESHEET_POLL_INTERVAL_MS=60000
TIMESHEET_BATCH_SIZE=5
TIMESHEET_STALE_LOCK_MS=600000

# ── Interview scheduling (calendar / meeting providers) ──────────────────────
# Once a candidate is shortlisted, recruiters book interviews with a time slot, a
# mode (video/phone/onsite) and a provider that mints the calendar event + meeting
# link. Safe-by-default: the "manual" provider is ALWAYS available (recruiter pastes
# the link / location), so scheduling works before any integration is configured.
# When you add Google/Teams credentials below and enable them, the same flow creates
# real external events and Meet/Teams links automatically.

# Which provider is pre-selected in the UI. One of: manual | google | teams.
INTERVIEW_DEFAULT_PROVIDER=teams

# Slot generation + booking guardrails (minutes).
INTERVIEW_SLOT_GRANULARITY_MIN=30
INTERVIEW_BUFFER_MIN=15
INTERVIEW_DEFAULT_DURATION_MIN=60

# Google Calendar (Meet links via conferenceData). Authenticate with EITHER an OAuth
# refresh-token trio (client id/secret/refresh token) OR a service-account JSON string.
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Alternatively, paste the service-account key JSON as a single-line string.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
# Calendar to create events on ("primary" = the authenticated account's calendar).
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEOUT_MS=15000

# Microsoft Teams (online meetings via Microsoft Graph, client-credentials flow).
MS_TEAMS_ENABLED=true
MS_TEAMS_TENANT_ID=
MS_TEAMS_CLIENT_ID=
MS_TEAMS_CLIENT_SECRET=
# The Graph user (object id or UPN) whose calendar hosts the online meeting.
MS_TEAMS_ORGANIZER_USER_ID=
MS_TEAMS_TIMEOUT_MS=15000

# ── Chat / messaging ─────────────────────────────────────────────────────────
# Real-time delivery uses Socket.IO attached to the same HTTP server. Retention:
# a background worker soft-deletes messages older than CHAT_RETENTION_MONTHS.
CHAT_CLEANUP_ENABLED=true
CHAT_RETENTION_MONTHS=6
CHAT_CLEANUP_INTERVAL_MS=86400000
CHAT_CLEANUP_BATCH_SIZE=500
CHAT_MAX_MESSAGE_LENGTH=4000
